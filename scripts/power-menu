#!/usr/bin/env bash

# rofi-power
# Use rofi to call systemctl for shutdown, reboot, etc

# 2016 Oliver Kraitschy - http://okraits.de
# Adapted by Matthias Klan 2020

DOCKED_MODE_SCRIPT="$HOME/.config/hypr/scripts/docked-mode.sh"

if [ -x "$DOCKED_MODE_SCRIPT" ]; then
    DOCKED_STATUS=$("$DOCKED_MODE_SCRIPT" --status)
    if [ "$DOCKED_STATUS" = "on" ]; then
        DOCKED_LABEL="Disable Docked Mode"
    else
        DOCKED_LABEL="Enable Docked Mode"
    fi
else
    DOCKED_LABEL="Enable Docked Mode"
fi

THEME_MODE_FILE="$HOME/.cache/theme-mode"
SWITCH_THEME_SCRIPT="$(command -v switch-theme.sh || echo "$HOME/.local/bin/switch-theme.sh")"

if [ -f "$THEME_MODE_FILE" ]; then
    THEME_MODE=$(tr -d '\r\n' < "$THEME_MODE_FILE")
else
    THEME_MODE="dark"
fi

if [ "$THEME_MODE" = "light" ]; then
    THEME_LABEL="Switch to Dark Theme"
else
    THEME_LABEL="Switch to Light Theme"
fi

LAUNCHER="rofi -width 20 -height 1 -dmenu -i -p Logout -location 3 -yoffset 30 -xoffset -30"
OPTIONS="Logout\nLock\n$DOCKED_LABEL\n$THEME_LABEL\nReboot\nShutdown\nSuspend"

option=`echo -e $OPTIONS | $LAUNCHER | tr -d '\r\n'`
if [ ${#option} -gt 0 ]
then
    case $option in
      Logout)
        quit-hypr.sh
        ;;
      Lock)
        ~/.config/hypr/scripts/lock.sh
        ;;
      Enable\ Docked\ Mode)
        "$DOCKED_MODE_SCRIPT" --toggle
        ;;
      Disable\ Docked\ Mode)
        "$DOCKED_MODE_SCRIPT" --toggle
        ;;
      Switch\ to\ Dark\ Theme)
        "$SWITCH_THEME_SCRIPT" dark
        ;;
      Switch\ to\ Light\ Theme)
        "$SWITCH_THEME_SCRIPT" light
        ;;
      Reboot)
        systemctl reboot
        ;;
      Shutdown)
        systemctl poweroff
        ;;
      Suspend)
        systemctl suspend
        ;;
      *)
        ;;
    esac
fi
